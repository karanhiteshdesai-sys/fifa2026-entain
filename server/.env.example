# AWS RDS PostgreSQL Connection
# Format: postgresql://<username>:<password>@<rds-endpoint>:<port>/<database>
DATABASE_URL=postgresql://fifa2026_admin:YOUR_PASSWORD@fifa2026-db.xxxxxxxxxxxx.eu-west-1.rds.amazonaws.com:5432/fifa2026_db

# Environment
NODE_ENV=production

# JWT Secret
JWT_SECRET=your-jwt-secret-here

# Football API (for live odds)
FOOTBALL_API_KEY=your-api-key

# Frontend URL (for CORS)
FRONTEND_URL=https://fifa2026-entain.vercel.app
